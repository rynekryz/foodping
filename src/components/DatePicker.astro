<div id="datePicker" style="display:none">
   <div id="datePickerBackdrop" data-action="closeDatePicker"></div>
   <div id="datePickerSheet">
      <div id="datePickerHeader">
         <button id="datePickerCancel" data-action="closeDatePicker">Cancel</button>
         <span id="datePickerTitle">Expiry Date</span>
         <button id="datePickerDone" data-action="confirmDate">Done</button>
      </div>
      <div id="datePickerBody">
         <div id="datePickerSelector"></div>
         <div class="drum-wrapper">
            <div class="drum-fade-top"></div>
            <div class="drum-scroll" id="dayScroll"></div>
            <div class="drum-fade-bottom"></div>
         </div>
         <div class="drum-wrapper">
            <div class="drum-fade-top"></div>
            <div class="drum-scroll" id="monthScroll"></div>
            <div class="drum-fade-bottom"></div>
         </div>
         <div class="drum-wrapper">
            <div class="drum-fade-top"></div>
            <div class="drum-scroll" id="yearScroll"></div>
            <div class="drum-fade-bottom"></div>
         </div>
      </div>
   </div>
</div>
